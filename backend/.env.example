# Used when running the backend directly on the host.
DATABASE_URL=postgresql+psycopg://ludex:ludex@localhost:5432/ludex
DEPLOYMENT_ENVIRONMENT=local

# Operator-only direct connection for Alembic. Local development falls back to
# DATABASE_URL when this is absent. Do not provide it to hosted web workers.
# MIGRATION_DATABASE_URL=postgresql+psycopg://migrator:replace-me@direct-host/ludex

# Browser origin allowed to call the backend.
FRONTEND_ORIGIN=http://localhost:5173
STEAM_RATE_LIMIT_HMAC_KEY=local-development-only

# Local HTTP only. Keep the production default (`true`) for HTTPS deployments.
ACCESS_SESSION_COOKIE_SECURE=false

# Required for Steam profile and library imports. Keep this backend-only.
STEAM_API_KEY=replace-with-your-steam-web-api-key

# Required for backend-only IGDB metadata enrichment.
IGDB_CLIENT_ID=replace-with-your-twitch-client-id
IGDB_CLIENT_SECRET=replace-with-your-twitch-client-secret

# Deferred experiment only; not used by the active recommendation flow.
# Optional; omit it entirely when the experiment is disabled.
# GEMINI_API_KEY=replace-with-your-gemini-api-key
